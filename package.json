{
  "name": "sunland-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace @sunland-ai/api",
    "dev:playground": "npm run dev --workspace @sunland-ai/playground"
  },
  "engines": {
    "node": ">=20"
  }
}
